# determinator — tier definitions. Sourced into your interactive shell by the
# installer's rc block, and by bin/determinator / bin/determinator-escalate.
# Installed to ~/.config/determinator/determinator.env. PUT NO SECRETS HERE.
#
# Each tier is the SAME `claude` binary; only the backend env vars differ:
#   local / cloud -> Ollama's Anthropic-compatible endpoint at localhost:11434
#   premium       -> Anthropic, via your Claude subscription login (or opt-in API key)

_det_cfg="${DETERMINATOR_CONFIG_DIR:-$HOME/.config/determinator}"

# Default models per tier (DET_LOCAL_MODEL / DET_CLOUD_MODEL / DET_PREMIUM_MODEL).
# shellcheck source=/dev/null
[ -f "$_det_cfg/models.conf" ] && . "$_det_cfg/models.conf"

# Tier 1 — truly local Ollama (free, on-machine).
determinator_local() {
  export ANTHROPIC_BASE_URL="http://localhost:11434"
  export ANTHROPIC_AUTH_TOKEN="ollama"
  export ANTHROPIC_API_KEY=""
  export DET_TIER="local"
  export DET_MODEL="${DET_LOCAL_MODEL:-llama3.1:8b}"
}

# Tier 2 — Ollama ":cloud" model (cheap; requires a one-time `ollama signin`).
# The local daemon proxies the cloud model, so the base URL stays localhost.
determinator_cloud() {
  export ANTHROPIC_BASE_URL="http://localhost:11434"
  export ANTHROPIC_AUTH_TOKEN="ollama"
  export ANTHROPIC_API_KEY=""
  export DET_TIER="cloud"
  export DET_MODEL="${DET_CLOUD_MODEL:-qwen3-coder:480b-cloud}"
}

# Tier 3 — premium Anthropic. DEFAULT = your Claude subscription (OAuth):
# we UNSET the Ollama vars and the API key so `claude` uses its stored login,
# which does NOT incur metered API billing. Opt-in metered API: if
# ~/.config/determinator/secrets.env exports ANTHROPIC_API_KEY, it is used instead.
determinator_premium() {
  unset ANTHROPIC_BASE_URL ANTHROPIC_AUTH_TOKEN ANTHROPIC_API_KEY
  # shellcheck source=/dev/null
  [ -f "$_det_cfg/secrets.env" ] && . "$_det_cfg/secrets.env"
  export DET_TIER="premium"
  export DET_MODEL="${DET_PREMIUM_MODEL:-claude-opus-4-8}"
}
